generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AthleteStatus {
  DRAFT
  PENDING
  FAYDA_VERIFIED
  APPROVED
  ACTIVE
  SUSPENDED
  REJECTED
}

enum RegistrationSource {
  SELF
  CLUB_ADMIN
}

enum ClubVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum DominantHand {
  LEFT
  RIGHT
  AMBIDEXTROUS
}

enum DominantFoot {
  LEFT
  RIGHT
  BOTH
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
  CANCELLED
}

enum PolicyScope {
  CLUB
  EVENT
  ATHLETE_PARTICIPATION
}

enum PolicyStatus {
  ACTIVE
  INACTIVE
}

enum PolicyAuditAction {
  CREATED
  UPDATED
  ASSIGNED
  UNASSIGNED
}

enum EventAttendeeType {
  ATHLETE
  CLUB
}

enum PaymentProvider {
  MOCK_TELEBIRR
}

enum PaymentType {
  EVENT_REGISTRATION
  EVENT_FEE
  CLUB_FEE
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum EventRegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

enum VerificationType {
  EMAIL
  PHONE
}

enum VerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
}

enum FaydaVerificationStatus {
  PENDING
  OTP_SENT
  CONFIRMED
  FAILED
  EXPIRED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id          String     @id @default(cuid())
  email       String?    @unique
  password    String
  firstName   String
  lastName    String
  phoneNumber String?    @unique

  status      UserStatus @default(PENDING)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  phoneVerified   Boolean   @default(false)
  phoneVerifiedAt DateTime?

  roles              UserRole[]
  auditLogs          AuditLog[]
  athlete            Athlete?
  registeredAthletes Athlete[] @relation("RegisteredAthletes")
  coaches            Coach[]
  registeredCoaches  Coach[]   @relation("RegisteredCoaches")
  verifiedClubs      Club[]    @relation("VerifiedClubs")
  adminOf            Club?     @relation("ClubAdmin")
  verifications      UserVerification[]
  eventsCreated      Event[]   @relation("EventCreator")
  eventsApproved     Event[]   @relation("EventApprover")
  eventStatusChanges EventStatusHistory[]
  policiesCreated    Policy[] @relation("PolicyCreator")
  policiesUpdated    Policy[] @relation("PolicyUpdater")
  policyAuditEntries PolicyAuditLog[]
  policyAssignments  PolicyAssignment[] @relation("PolicyAssignmentCreator")
  qrTokensGenerated  EventQrToken[] @relation("QrTokenGenerator")
  eventCheckIns      EventCheckIn[] @relation("CheckInScanner")
  payments           Payment[]
  eventRegistrations EventRegistration[]
}

model Sport {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  athletes    Athlete[]
  coaches     Coach[]
  athleteSports AthleteSport[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AthleteSport {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sportId   String
  sport     Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([athleteId, sportId])
  @@index([athleteId])
  @@index([sportId])
}

model Club {
  id                 String                 @id @default(cuid())
  name               String
  shortName          String?
  email              String?                @unique
  phone              String?
  address            String?
  city               String?
  region             String?
  registrationNumber String?                @unique
  licenseNumber      String?                @unique
  logoUrl            String?
  verificationStatus ClubVerificationStatus @default(PENDING)
  verifiedBy         String?
  verifiedAt         DateTime?
  rejectionReason    String?
  adminId            String?                @unique
  admin              User?                  @relation("ClubAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  athletes           Athlete[]
  coaches            Coach[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  verifier           User?                  @relation("VerifiedClubs", fields: [verifiedBy], references: [id])
  policyAssignments  PolicyAssignment[]
  eventAttendees     EventAttendee[]

  @@index([verificationStatus])
  @@index([name])
}

model Athlete {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sportId String?
  sport   Sport?  @relation(fields: [sportId], references: [id])

  clubId   String?
  clubName String?
  club     Club?   @relation(fields: [clubId], references: [id])

  dateOfBirth DateTime
  gender      Gender
  nationality String

  region              String?
  emergencyContactPhone String?

  photoUrl      String?
  amharicName   String?
  primaryEvent  String?

  height Int?
  weight Int?

  dominantHand DominantHand?
  dominantFoot DominantFoot?
  bloodType    BloodType?

  position     String?
  jerseyNumber Int?

  status             AthleteStatus      @default(DRAFT)
  registrationSource RegistrationSource @default(SELF)
  registeredById     String?
  registeredBy       User?              @relation("RegisteredAthletes", fields: [registeredById], references: [id])

  faydaVerified   Boolean   @default(false)
  faydaVerifiedAt DateTime?
  faydaNin        String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faydaVerifications FaydaVerification[]
  eventAttendees     EventAttendee[]
  eventRegistrations EventRegistration[]
  payments           Payment[]
  athleteSports      AthleteSport[]
  personalBests      PersonalBest[]
  trainingLogs       TrainingLog[]
  weightLogs         WeightLog[]
}

enum PersonalBestScope {
  ALL_TIME
  SEASON
}

model PersonalBest {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  event  String
  mark   String
  date   DateTime?
  venue  String?
  scope  PersonalBestScope @default(ALL_TIME)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId])
}

model TrainingLog {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  date             DateTime
  type             String
  distanceKm       Float
  durationMinutes  Int
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId])
}

model WeightLog {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  date      DateTime
  weightKg  Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId])
}

model Coach {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sportId String?
  sport   Sport?  @relation(fields: [sportId], references: [id])

  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id])

  licenseNumber     String?
  specialization    String?
  yearsOfExperience Int?

  registrationSource RegistrationSource @default(SELF)
  registeredById     String?
  registeredBy       User?              @relation("RegisteredCoaches", fields: [registeredById], references: [id])

  status AthleteStatus @default(DRAFT)

  faydaVerified   Boolean   @default(false)
  faydaVerifiedAt DateTime?
  faydaNin        String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faydaVerifications FaydaVerification[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model FaydaVerification {
  id         String                  @id @default(cuid())

  athleteId  String?
  athlete    Athlete?                @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  coachId    String?
  coach      Coach?                  @relation(fields: [coachId], references: [id], onDelete: Cascade)

  nin        String
  otp        String
  otpExpiresAt DateTime

  status     FaydaVerificationStatus @default(PENDING)

  verifiedData Json?

  attempts   Int      @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([athleteId])
  @@index([coachId])
}

model UserVerification {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationType
  code      String
  expiresAt DateTime
  status    VerificationStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId])
  @@index([code])
}

model Event {
  id             String      @id @default(cuid())
  title          String
  description    String?
  category       String
  rules          String
  schedule       Json
  venue          String?
  organizerName  String
  organizerEmail String?
  organizerPhone String?
  status         EventStatus @default(DRAFT)

  disciplines         Json?
  bannerUrl           String?
  registrationDeadline DateTime?

  createdById String
  createdBy   User @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById String?
  approvedBy   User? @relation("EventApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt  DateTime?
  publishedAt DateTime?
  rejectionReason String?

  statusHistory EventStatusHistory[]
  policyAssignments PolicyAssignment[]
  attendees         EventAttendee[]
  registrations     EventRegistration[]
  payments          Payment[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([category])
}

model EventStatusHistory {
  id             String      @id @default(cuid())
  eventId        String
  event          Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  previousStatus EventStatus?
  newStatus      EventStatus
  reason         String?
  changedById    String
  changedBy      User        @relation(fields: [changedById], references: [id], onDelete: Restrict)
  createdAt      DateTime    @default(now())

  @@index([eventId, createdAt])
}

model EventAttendee {
  id          String            @id @default(cuid())
  eventId     String
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendeeType EventAttendeeType
  athleteId   String?
  athlete     Athlete?          @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  clubId      String?
  club        Club?             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  qrTokens    EventQrToken[]
  checkIn     EventCheckIn?
  createdAt   DateTime          @default(now())

  @@unique([eventId, athleteId])
  @@unique([eventId, clubId])
  @@index([eventId, attendeeType])
}

model EventQrToken {
  id            String        @id @default(cuid())
  token         String        @unique
  attendeeId    String
  attendee      EventAttendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  usedAt        DateTime?
  generatedById String
  generatedBy   User          @relation("QrTokenGenerator", fields: [generatedById], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now())

  @@index([token])
  @@index([expiresAt])
}

model EventCheckIn {
  id          String        @id @default(cuid())
  attendeeId  String        @unique
  attendee    EventAttendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  checkedInAt DateTime      @default(now())
  checkedInById String
  checkedInBy   User        @relation("CheckInScanner", fields: [checkedInById], references: [id], onDelete: Restrict)

  @@index([checkedInAt])
}

model EventRegistration {
  id        String                  @id @default(cuid())
  eventId   String
  event     Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   Athlete                  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  status    EventRegistrationStatus @default(PENDING_PAYMENT)
  payment   Payment?
  createdById String
  createdBy   User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([eventId, athleteId])
  @@index([eventId, status])
}

model Payment {
  id          String          @id @default(cuid())
  reference   String          @unique
  provider    PaymentProvider @default(MOCK_TELEBIRR)
  type        PaymentType
  status      PaymentStatus   @default(PENDING)
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("ETB")
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  eventId     String?
  event       Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  athleteId   String?
  athlete     Athlete?        @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  registrationId String?      @unique
  registration   EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  externalTransactionId String? @unique
  providerPayload Json?
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  history     PaymentStatusHistory[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([eventId])
}

model PaymentStatusHistory {
  id          String        @id @default(cuid())
  paymentId   String
  payment     Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  previousStatus PaymentStatus?
  newStatus      PaymentStatus
  transactionId  String?
  payload        Json?
  createdAt      DateTime    @default(now())

  @@index([paymentId, createdAt])
}

model Policy {
  id          String       @id @default(cuid())
  code        String       @unique
  title       String
  description String?
  scope       PolicyScope
  rules       Json
  status      PolicyStatus @default(ACTIVE)
  createdById String
  createdBy   User         @relation("PolicyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String
  updatedBy   User         @relation("PolicyUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  assignments PolicyAssignment[]
  auditLogs   PolicyAuditLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([scope, status])
}

model PolicyAssignment {
  id          String   @id @default(cuid())
  policyId    String
  policy      Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  clubId      String?
  club        Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation("PolicyAssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@unique([policyId, clubId])
  @@unique([policyId, eventId])
  @@index([clubId])
  @@index([eventId])
}

model PolicyAuditLog {
  id          String            @id @default(cuid())
  policyId    String
  policy      Policy            @relation(fields: [policyId], references: [id], onDelete: Cascade)
  action      PolicyAuditAction
  oldValue    Json?
  newValue    Json?
  changedById String
  changedBy   User              @relation(fields: [changedById], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now())

  @@index([policyId, createdAt])
}

// ─── News ──────────────────────────────────────────────────────────────────

enum NewsCategory {
  CHAMPIONSHIP
  TRAINING
  ANNOUNCEMENT
  COMMUNITY
  RECOGNITION
  GENERAL
}

model News {
  id               String       @id @default(cuid())
  title            String
  shortDescription String
  content          String
  category         NewsCategory @default(GENERAL)
  imageUrl         String?
  insideImages     String[]     @default([])
  author           String       @default("EAF Communications Department")
  isFeatured       Boolean      @default(false)
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([category])
  @@index([isFeatured])
  @@index([publishedAt])
}
