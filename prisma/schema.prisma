generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AthleteStatus {
  PENDING
  FAYDA_VERIFIED
  APPROVED
  ACTIVE
  SUSPENDED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}
enum DominantHand {
  LEFT
  RIGHT
  AMBIDEXTROUS
}enum DominantFoot {
  LEFT
  RIGHT
  BOTH
}
enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  password    String
  firstName   String
  lastName    String
  phoneNumber String?     @unique

  status      UserStatus  @default(PENDING)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  roles       UserRole[]
  auditLogs   AuditLog[]
  athlete     Athlete?
}

model Sport {

  id String @id @default(cuid())

  name String @unique

  description String?

  athletes Athlete[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}
model Club {

  id String @id @default(cuid())

  name String

  registrationNumber String @unique

  athletes Athlete[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}


model Athlete {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sportId String?
  sport   Sport?  @relation(fields: [sportId], references: [id])

  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id])

  dateOfBirth DateTime
  gender      Gender
  nationality String

  height Int?
  weight Int?

  dominantHand DominantHand?
  dominantFoot DominantFoot?
  bloodType    BloodType?

  position     String?
  jerseyNumber Int?

  status AthleteStatus @default(PENDING)

  faydaVerified   Boolean   @default(false)
  faydaVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuditLog {
  id String @id @default(cuid())

  userId String

  action String

  entity String

  entityId String?

  oldValue Json?

  newValue Json?

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}