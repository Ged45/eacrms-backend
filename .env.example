# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev (outside Docker): use localhost
# Inside Docker: use postgres (the service name)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eacrms

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Resend (Email) ───────────────────────────────────────────────────────────
# Sign up at https://resend.com → API Keys → Create API Key
# Free tier: 3,000 emails/month, 100/day — no credit card needed
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Sender email address only — NO angle brackets, NO display name
# The app adds "EACRMS <...>" formatting automatically
# Without a verified domain, use Resend's shared address (only delivers to your own Resend account email)
RESEND_FROM_EMAIL=onboarding@resend.dev
# Once you verify your domain: RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── AfroMessage (SMS) ──────────────────────────────────────────────────────
# Sign up at https://afromessage.com → Developers → API Keys
# Ethiopian SMS provider — recommended for local delivery
AFRO_API_KEY=your_afromessage_api_key_here
AFRO_SENDER_ID=EACRMS

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
# development → codes returned in API responses (for testing)
# production  → codes only sent via email/SMS, never in responses
NODE_ENV=development
EXPOSE_OTP=true
# Set to "true" on staging/dev servers to expose Fayda OTP in API responses
# even when NODE_ENV=production (Docker default)

# Mock payment gateway webhook authentication.
# Set a unique value in Render before enabling the mock callback endpoint.
MOCK_PAYMENT_WEBHOOK_SECRET=mock-dev-secret
