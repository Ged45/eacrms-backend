# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev (outside Docker): use localhost
# Inside Docker: use postgres (the service name)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eacrms

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Resend (Email) ───────────────────────────────────────────────────────────
# Sign up at https://resend.com → API Keys → Create API Key
# Free tier: 3,000 emails/month, 100/day — no credit card needed
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Sender email address only — NO angle brackets, NO display name
# The app adds "EACRMS <...>" formatting automatically
# Without a verified domain, use Resend's shared address (only delivers to your own Resend account email)
RESEND_FROM_EMAIL=onboarding@resend.dev
# Once you verify your domain: RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── Africa's Talking (SMS) ───────────────────────────────────────────────────
# Sign up at https://africastalking.com → Dashboard → Settings → API Key
# Use username=sandbox + any API key for free sandbox testing
# Sandbox simulator: https://simulator.africastalking.com
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key_here
# Sender ID registered in your AT dashboard (sandbox: use "EACRMS" or leave default)
AT_SENDER_ID=EACRMS

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=5000
# development → codes returned in API responses (for testing)
# production  → codes only sent via email/SMS, never in responses
NODE_ENV=development
